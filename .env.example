# ---- Server (packages/server) ----
# Port the Fastify server listens on.
PORT=8080
# Interface to bind to.
# HOST=0.0.0.0
# Path to the SQLite database file. Use ":memory:" for ephemeral storage.
# DB_PATH=./packages/server/data/emberlink.db
# Set to "production" when serving the built web app from the same origin.
# NODE_ENV=production
# How often (ms) to purge expired/consumed rows.
# SWEEP_INTERVAL_MS=60000
# Serve HTTPS directly (e.g. for LAN testing) by pointing these at a local cert/key.
# TLS_KEY_FILE=./certs/key.pem
# TLS_CERT_FILE=./certs/cert.pem

# ---- Web (packages/web) ----
# API origin for the browser. Empty = same origin (production default).
# Set for dev in packages/web/.env.development (already provided).
# VITE_API_BASE=http://localhost:8080
# Origin used to build shareable links. Empty = window.location.origin.
# Set this for the desktop build to your deployed server URL, e.g.:
# VITE_PUBLIC_URL=https://secrets.example.com
